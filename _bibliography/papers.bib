@article{PhysRev.47.777,
  abbr={ESWA},
  title={Multi-feature representation-based graph attention networks for predicting potential supply relationships in a large-scale supply chain network},
  author={D. Lee and J. Go and T. Noh and S. Song},
  abstract={This study aims to predict potential supply relationships within a large-scale supply chain network. Identifying appropriate suppliers can help companies mitigate disruptions in the supply of materials and finances. Furthermore, it offers the companies potential profits by enabling more effective resource allocation and fostering innovation. While previous studies have adopted machine learning approaches, these methods may not fully capture the complexity of network topology. Graph neural network-based methods have recently gained attention as a promising alternative. However, since graph neural network-based methods mainly rely on fixed aggregation weights, these methods often struggle to capture the complexity of supply relationships between companies. This study proposes multi-feature representation-based graph attention networks, which explore hidden topological relationships between companies by incorporating semantic characteristics such as product and network features. Our findings demonstrate that the proposed method outperforms machine learning-based and state-of-the-art graph neural network-based methods. In addition, ablation studies confirm that the proposed components significantly improve prediction performance.},
  journal={Expert Systems with Applications},
  location={},
  volume={292},
  issue={},
  pages={777--780},
  numpages={0},
  year={2025},
  month={May},
  publisher=aps,
  doi={https://doi.org/10.1016/j.eswa.2025.128593},
  html={https://www.sciencedirect.com/science/article/abs/pii/S0957417425022122},
}

@article{PhysRev.47.777,
  abbr={IJPEM-GT},
  title={ElectroTwin: A Digital Twin-Driven Framework for Designing and Scheduling of Electroplating Facilities},
  author={D. Lee and T. Noh and J. Go and I. Park and K. Kim},
  abstract={In modern electroplating lines, it is crucial to determine the appropriate number of hoists and their feasible movements, as it directly impacts production efficiency and mitigates environmental pollution caused by the corrosion of plated parts. Unfortunately, scheduling decisions are still carried out manually or delegated to outsourcing companies due to a lack of in-house expertise in complicated formulation and optimization of the scheduling problem, causing additional costs. Moreover, most outsourcing companies do not provide visual insights into operational outcomes, such as overall production workflows, bottlenecks, and cost structures, making it difficult for facility operators to plan investments and make informed decisions. To address these challenges, this paper proposes a digital twin-driven decision-support framework that integrates a constraint-based search method and visual analytics. Specifically, the proposed constraint-based search method determines the appropriate number of hoists and their feasible movement schedules while satisfying a given cycle time, which automates the complex computation scheduling process so that facility operators do not need to develop algorithms from scratch. The visual analytics component provides interpretable insights, including Gantt charts, bottleneck identification, and cost–profit estimation, which enables non-expert facility operators to make informed decisions and helps outsourcing providers deliver transparent services. Industrial case studies demonstrate that the proposed framework is effective in determining the appropriate number of hoists and their movements, outperforming the ground truth approach. Furthermore, the findings obtained through visual analytics suggest that the proposed approach enables practitioners to evaluate the long-term financial impact of various configurations for building a sustainable manufacturing system in electroplating facilities.},
  journal={International Journal of Precision Engineering and Manufacturing-Green Technology},
  location={},
  volume={},
  issue={},
  pages={1-16},
  numpages={0},
  year={2026},
  month={March},
  publisher=aps,
  doi={https://doi.org/10.1007/s40684-026-00867-9},
  html={https://link.springer.com/article/10.1007/s40684-026-00867-9},
}